{
  "name": "project-harness-typescript",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:harness": "node --test tests/harness.test.cjs",
    "test:profile": "node scripts/test-profile.cjs",
    "test:slow": "node scripts/test-profile-summary.cjs",
    "check:loc": "node scripts/check-loc.cjs",
    "check:links": "node scripts/check-markdown-commonmark-links.cjs",
    "check:readme": "node scripts/check-readme-coverage.cjs",
    "doctor": "node scripts/check-doctor.cjs",
    "check": "node scripts/check-local.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "remark-parse": "^11.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "unified": "^11.0.5"
  }
}
